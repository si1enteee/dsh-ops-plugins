{
  "name": "@elinpf/dsh-ops",
  "version": "0.4.2",
  "description": "Single-package deployment unit for the dsh-ops plugin suite: host-plane rows plus the ops agent preset, over the granular @elinpf/dsh-ops-* packages.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-ops": "./bin/dsh-ops.mjs"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "bin",
    "presets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/ops.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-command-compact": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ralph": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.0-rc.2",
    "@elinpf/dsh-ops-access": "workspace:^",
    "@elinpf/dsh-ops-access-ceph": "workspace:^",
    "@elinpf/dsh-ops-access-gate": "workspace:^",
    "@elinpf/dsh-ops-access-k8s": "workspace:^",
    "@elinpf/dsh-ops-access-prometheus": "workspace:^",
    "@elinpf/dsh-ops-access-ssh": "workspace:^",
    "@elinpf/dsh-ops-access-ui": "workspace:^",
    "@elinpf/dsh-ops-knowledge": "workspace:^",
    "@elinpf/dsh-ops-panel": "workspace:^",
    "@elinpf/dsh-ops-prompts": "workspace:^",
    "@elinpf/dsh-ops-tool-ceph": "workspace:^",
    "@elinpf/dsh-ops-tool-environment": "workspace:^",
    "@elinpf/dsh-ops-tool-kubectl": "workspace:^",
    "@elinpf/dsh-ops-tool-prometheus": "workspace:^",
    "@elinpf/dsh-ops-tool-ssh": "workspace:^",
    "@elinpf/dsh-ops-tool-trace": "workspace:^",
    "@elinpf/dsh-ops-trace-ui": "workspace:^"
  },
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
